# Copy to .env and fill in. Never commit real values.

# PostgreSQL connection used by the app, migrations and seed.
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/bat_scheduler?schema=public"

# Separate database for integration/E2E tests. Tests refuse to run if this equals DATABASE_URL.
TEST_DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/bat_scheduler_test?schema=public"

# 32+ random bytes, base64. Used to HMAC session tokens before they are stored.
SESSION_SECRET="generate-with: node -e \"console.log(require('crypto').randomBytes(32).toString('base64'))\""

# Public origin of the app. Mutating API requests must come from this origin (CSRF check).
APP_URL="http://localhost:3000"

# Media storage: "local" (filesystem) or "vercel-blob" (see docs/vercel.md).
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage/uploads"
MAX_UPLOAD_MB="50"

# debug | info | warn | error
LOG_LEVEL="info"

# Vercel only: set automatically when a Blob store is connected to the project.
# STORAGE_DRIVER defaults to "vercel-blob" on Vercel and "local" elsewhere.
BLOB_READ_WRITE_TOKEN=""

# First Super Administrator, created on deploy / server start when no account with this email exists.
# Remove ADMIN_PASSWORD after the first sign-in. Password: 12+ chars, upper- and lower-case and a digit.
# ADMIN_EMAIL=""
# ADMIN_PASSWORD=""
# ADMIN_NAME=""
